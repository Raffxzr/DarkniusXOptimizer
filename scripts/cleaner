#!/system/bin/sh
MODDIR="/data/adb/modules/DarkniusXOptimizer"
[ ! -d "$MODDIR" ] && MODDIR="/data/adb/modules/RaffOptimizer"
PROPFILE="${MODDIR}/module.prop"
RUNDIR="/data/adb/darkniusx/run"
LOGFILE="${RUNDIR}/cleaner.log"
mkdir -p "${RUNDIR}"

current_time=$(date +"%I:%M %P")

log() {
  case $1 in
    info)
      [ -t 1 ] && echo -e "\033[1;33m${current_time} [info]: $2\033[0m" || echo "${current_time} [info]: $2"
    ;;
    *)
      [ -t 1 ] && echo -e "\033[1;34m${current_time} [$1]: $2\033[0m" || echo "${current_time} [$1]: $2"
    ;;
  esac
}

cleaner() {
  log info "$(date)"
  log info "DarkniusX Cache Cleaner started"
  log info "Cleaning app cache..."

  echo "$(date)" > "${LOGFILE}"
  echo "$(date +"[%H:%M %z]") [info]: Cleaning app cache (Manual)" >> "${LOGFILE}"

  total=0
  for dir in "/data/data/*/cache" "/data/data/*/code_cache" "/data/user_de/*/*/cache" "/data/user_de/*/*/code_cache" "/sdcard/Android/data/*/cache" "/data/system/dropbox"; do
    size=$(du -cs $dir 2>/dev/null | grep total | cut -f 1 | head -n 1)
    [ -z "$size" ] && size=0
    total=$(( total + size ))
    log debug "$dir >>>>> ${size} KB"
    find $dir/* -delete >/dev/null 2>&1
  done

  echo "$(date +"[%H:%M %z]") [info]: Cache clean finished." >> "${LOGFILE}"

  if [ "${total}" -ge 1024 ]; then
    total_cache="$(( total / 1024 )) MB"
  else
    total_cache="${total} KB"
  fi

  escaped_total_cache=$(printf '%s\n' "${total_cache}" | sed -e 's/[\/&]/\\&/g')

  if [ -f "$PROPFILE" ]; then
    sed -Ei "s/^description=.*/description=[ $current_time | Cleaned Cache: ${escaped_total_cache} ] DarkniusX Optimizer/g" "$PROPFILE"
  fi

  log info "Total Cache Cleaned: ${total_cache}"
  log info "Done."
}

if [ "$(id -u)" -ne 0 ]; then
  log info "Run with root (su -c cleaner)"
  exit 1
else
  cleaner
fi
