#!/system/bin/sh
MODDIR="/data/adb/modules/RaffOptimizer"
VERSION=$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null | tr -d '\r')
[ -z "$VERSION" ] && VERSION="v1.4"

echo "=========================================="
echo "       RaffOptimizer $VERSION by Raffxzr      "
echo "=========================================="
echo "Quick Commands (Terminal / Termux):"
echo "  su -c cleaner                -> Clean App Caches"
echo "  su -c raff-flush [mode]      -> Flush RAM (safe|aggressive|extreme|custom)"
echo "  su -c flush / flush2 / flush3 / flush5 -> Binary Flush RAM"
echo "  su -c raff-freeze ...        -> Freeze/Unfreeze APK (Multi-User: user 0, 10, all)"
echo "  su -c raff-debloat ...       -> Remove/Restore APK (System & User Apps)"
echo "  su -c raff-webui open        -> Open WebUI in Browser (http://127.0.0.1:8899)"
echo "=========================================="
